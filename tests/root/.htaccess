# Sem URL público — nada nesta pasta é servido diretamente.
#
# Os utilitários daqui (e os de backend/) correm a partir do painel de testes,
# que os executa por index.php depois de atravessar o portão de acesso
# (autenticação + bilhete para os que escrevem). Um pedido direto a
# /labcontrol/tests/root/<arquivo> tem de apanhar 403, senão qualquer pessoa
# na rede consegue, por exemplo, executar fix-passwords.php.
#
# Isto não impede o PHP de incluir estes arquivos: as regras de .htaccess
# aplicam-se apenas a caminhos HTTP. index.php continua a conseguí-los.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
