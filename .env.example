# === DATABASE ===
DB_HOST=localhost
DB_NAME=labcontrol
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# === FIREBASE ===
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase/service-account.json
# Opcional: bundle de CAs para validar o TLS das chamadas à Google quando o php.ini
# não define curl.cainfo (XAMPP: C:\xampp\apache\bin\curl-ca-bundle.crt)
FIREBASE_CA_BUNDLE=

# === SECURITY ===
JWT_SECRET=labcontrol_secure_key_$(date +%s)_change_this_in_production
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# === NETWORK ===
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,If-None-Match

# === REMOTE CREDENTIALS (Windows/Network) ===
# Conta de administrador local das estações (usada pelo WinRM quando o host
# não tem credenciais próprias). NUNCA commitar valores reais neste ficheiro.
REMOTE_USER=CHANGE_ME_remote_admin_user
REMOTE_PASSWORD=CHANGE_ME_remote_admin_password

# === LOGGING ===
LOG_ENABLED=true
LOG_RETENTION_DAYS=90
DEBUG_MODE=false

# === TIMEZONE ===
# Deve corresponder ao fuso do laboratório (afeta todos os timestamps dos logs de auditoria)
APP_TIMEZONE=Africa/Luanda

# === RATE LIMITING ===
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=300

# === API ===
API_RATE_LIMIT=100
API_TIMEOUT=15000

# === TEMPO REAL (SSE) ===
# O frontend mantém uma ligação aberta em state.php?action=stream e só volta a
# pedir dados quando o fingerprint da BD muda. Não é necessário recarregar a
# página nem fazer polling de check-all.
# Cada aba visível ocupa 1 worker Apache enquanto a ligação dura; ajuste estes
# valores conforme o nº de operadores em simultâneo.
# SSE_POLL_INTERVAL: segundos entre verificações do estado no servidor
# SSE_HEARTBEAT: segundos entre keep-alives (comentários SSE)
# SSE_MAX_DURATION: segundos até emitir `bye` e libertar o worker
# SSE_RETRY_MS: reconexão automática do EventSource após uma queda
# Nota: o loadEnv() deste projeto não remove comentários no fim da linha.
SSE_POLL_INTERVAL=2
SSE_HEARTBEAT=15
SSE_MAX_DURATION=120
SSE_RETRY_MS=3000
