# === DATABASE ===
DB_HOST=localhost
DB_NAME=labcontrol
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# === FIREBASE ===
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase/service-account.json
# Opcional: bundle de CAs para validar o TLS das chamadas à Google quando o php.ini
# não define curl.cainfo (XAMPP: C:\xampp\apache\bin\curl-ca-bundle.crt)
FIREBASE_CA_BUNDLE=

# === SECURITY ===
# Segredos de sessão/criptografia. Deixe VAZIO: o backend gera valores fortes e
# grava-os aqui no primeiro arranque (o ficheiro tem de ser gravável pelo Apache),
# ou gere manualmente: php -r "echo bin2hex(random_bytes(32));"
# NUNCA use um valor deste ficheiro de exemplo — seria público no repositório.
JWT_SECRET=
ENCRYPTION_KEY=
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# === NETWORK ===
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# === REMOTE CREDENTIALS (Windows/Network) ===
# Conta de administrador local das estações (usada pelo WinRM quando o host
# não tem credenciais próprias). NUNCA commitar valores reais neste ficheiro.
REMOTE_USER=CHANGE_ME_remote_admin_user
REMOTE_PASSWORD=CHANGE_ME_remote_admin_password

# === LOGGING ===
LOG_ENABLED=true
LOG_RETENTION_DAYS=90
DEBUG_MODE=false

# === TIMEZONE ===
# Deve corresponder ao fuso do laboratório (afeta todos os timestamps dos logs de auditoria)
APP_TIMEZONE=Africa/Luanda

# === RATE LIMITING ===
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=300

# === API ===
API_RATE_LIMIT=100
API_TIMEOUT=15000
