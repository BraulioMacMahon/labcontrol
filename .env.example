# === DATABASE ===
DB_HOST=localhost
DB_NAME=labcontrol
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# === FIREBASE ===
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase/service-account.json
# Opcional: bundle de CAs para validar o TLS das chamadas à Google quando o php.ini
# não define curl.cainfo (XAMPP: C:\xampp\apache\bin\curl-ca-bundle.crt)
FIREBASE_CA_BUNDLE=

# === SECURITY ===
JWT_SECRET=labcontrol_secure_key_$(date +%s)_change_this_in_production
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# === NETWORK ===
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# === REMOTE CREDENTIALS (Windows/Network) ===
# Conta de administrador local das estações (usada pelo WinRM quando o host
# não tem credenciais próprias). NUNCA commitar valores reais neste ficheiro.
REMOTE_USER=CHANGE_ME_remote_admin_user
REMOTE_PASSWORD=CHANGE_ME_remote_admin_password

# === LOGGING ===
LOG_ENABLED=true
LOG_RETENTION_DAYS=90
DEBUG_MODE=false

# === TIMEZONE ===
# Deve corresponder ao fuso do laboratório (afeta todos os timestamps dos logs de auditoria)
APP_TIMEZONE=Africa/Luanda

# === RATE LIMITING ===
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=300

# === API ===
API_RATE_LIMIT=100
API_TIMEOUT=15000

# === BANCADA DE TESTES (pasta tests/ -> http://localhost/labcontrol/tests) ===
# Tudo aqui é opcional: sem estas linhas a bancada continua ligada e aberta à
# rede local. Não há login: quem consegue abrir o endereço vê o painel e os
# scripts. Scripts que escrevem/destroem ainda exigem confirmação + bilhete.
# Kill-switch: 'false' faz a área responder 503 a tudo (equivale a criar tests/DISABLED).
TESTS_ENABLED=true
# Quem pode abrir a página. Vazio = qualquer endereço (útil em DHCP instável).
# Aceita IPs e CIDRs separados por vírgula; em produção feche: 127.0.0.1,192.168.20.0/24
TESTS_ALLOWED_IPS=
# Papel usado na sessão anónima da bancada (a tabela users só tem admin e operator).
TESTS_ALLOWED_ROLES=admin
# Validade e inatividade da sessão própria da bancada (minutos).
TESTS_SESSION_MINUTES=480
TESTS_IDLE_MINUTES=90
# Segundos que um bilhete de confirmação dura (não há mais reconfirmação de senha).
TESTS_GRANT_SECONDS=60
# TESTS_REAUTH_MAX_AGE não é mais usado (não há login a revalidar).
TESTS_REAUTH_MAX_AGE=300
